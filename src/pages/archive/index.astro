---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('archive'))
  .filter((project) => project.data.year !== 'TEMPLATE')
  .sort((a, b) => a.data.year.localeCompare(b.data.year));
const initialIndex = 0;
const initialProject = projects[initialIndex];
---
<BaseLayout title="Project Archive — UNH MECC" description="Previous UNH Marine Energy Collegiate Competition projects.">
  <main id="main" class="archive-main">
    <section class="archive-hero compact-page-hero frame">
      <h1>Archive</h1>
    </section>
    {initialProject ? (
      <section class="archive-book-section frame" aria-label="Browse projects by year" style={`height:${160 + Math.max(0, projects.length - 1) * 60}svh`} data-archive-scroll-section>
        <div class="archive-book-sticky">
          <div class="archive-book-stage" data-archive-stage>
            <div class="archive-orbit" data-archive-orbit>
              {projects.map((project, index) => {
                const active = index === initialIndex;
                const images = (project.data.images.length
                  ? project.data.images
                  : project.data.coverImage
                    ? [project.data.coverImage]
                    : []).filter(Boolean);
                return (
                  <a
                    class:list={['archive-orbit-card', active && 'is-active']}
                    href={`/archive/${project.data.year}/`}
                    aria-label={`View ${project.data.year} project and team`}
                    aria-hidden={!active ? 'true' : 'false'}
                    tabindex={active ? 0 : -1}
                    data-archive-card
                    data-year={project.data.year}
                    data-card-index={index}
                    data-images={JSON.stringify(images)}
                    data-image-index="0"
                  >
                    {images.length > 0 ? (
                      <>
                        <img class="archive-card-image is-current" src={images[0]} alt="" decoding="async" loading={active ? 'eager' : 'lazy'} />
                        {images.length > 1 && <img class="archive-card-image archive-card-image-next" alt="" aria-hidden="true" decoding="async" />}
                      </>
                    ) : (
                      <span class="archive-card-placeholder" aria-hidden="true"></span>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
          <nav class="archive-timeline" aria-label="Choose an archive year">
            {projects.map((project, index) => (
              <button class="archive-year-button" type="button" data-archive-year={project.data.year} data-year-index={index} aria-pressed={index === initialIndex ? 'true' : 'false'}>
                {project.data.year}
              </button>
            ))}
          </nav>
        </div>
      </section>
    ) : null}
  </main>
</BaseLayout>

<script>
  const scrollSection = document.querySelector<HTMLElement>('[data-archive-scroll-section]');
  const stage = document.querySelector<HTMLElement>('[data-archive-stage]');
  const orbit = document.querySelector<HTMLElement>('[data-archive-orbit]');
  const yearButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-archive-year]'));
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-archive-card]'));
  let currentIndex = 0;
  let imageCycle: number | undefined;
  let transitionTimer: number | undefined;
  let yearJumpSettleTimer: number | undefined;
  let yearJumpFallbackTimer: number | undefined;
  let isProgrammaticYearJump = false;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobileArchive = window.matchMedia('(max-width: 650px)');
  let scrollFrame = 0;
  let pointerStart: { x: number; y: number; card: HTMLAnchorElement; mode: 'pending' | 'horizontal' } | undefined;
  let suppressCardClickUntil = 0;

  const stopImageCycle = () => {
    if (imageCycle !== undefined) window.clearInterval(imageCycle);
    imageCycle = undefined;
  };

  const startImageCycle = (card: HTMLAnchorElement) => {
    stopImageCycle();
    const images = JSON.parse(card.dataset.images ?? '[]') as string[];
    if (reducedMotion || images.length < 2) return;

    imageCycle = window.setInterval(() => {
      if (!card.classList.contains('is-active')) return;
      const currentImage = card.querySelector<HTMLImageElement>('.archive-card-image.is-current');
      const nextImage = card.querySelector<HTMLImageElement>('.archive-card-image-next');
      if (!currentImage || !nextImage) return;

      const nextIndex = (Number(card.dataset.imageIndex ?? 0) + 1) % images.length;
      let shown = false;
      const showNextImage = () => {
        if (shown || !card.classList.contains('is-active')) return;
        shown = true;
        requestAnimationFrame(() => {
          nextImage.classList.add('is-current');
          nextImage.classList.remove('archive-card-image-next');
          currentImage.classList.remove('is-current');
          currentImage.classList.add('archive-card-image-next');
          card.dataset.imageIndex = String(nextIndex);
        });
      };

      nextImage.onload = showNextImage;
      nextImage.onerror = () => { nextImage.onload = null; };
      nextImage.src = images[nextIndex];
    }, 5000);
  };

  const calculateOrbit = () => {
    if (!stage || !cards.length) return;
    const count = cards.length;
    stage.style.width = mobileArchive.matches ? 'calc(100% + 24px)' : '100%';
    stage.style.maxWidth = mobileArchive.matches ? 'none' : '100%';
    stage.style.marginLeft = mobileArchive.matches ? '-12px' : 'auto';
    stage.style.height = '100%';
    const availableWidth = stage.parentElement?.clientWidth ?? window.innerWidth;
    const cardWidth = Math.min(availableWidth * .85, stage.clientHeight * .72 * 4 / 3);
    stage.style.setProperty('--orbit-card-width', `${cardWidth}px`);
    if (currentIndex >= 0) {
      cards.forEach((card, index) => {
        card.style.setProperty('--card-x', `${mobileArchive.matches ? (index - currentIndex) * stage.clientWidth : 0}px`);
        card.style.setProperty('--card-y', `${mobileArchive.matches ? 0 : (index - currentIndex) * stage.clientHeight}px`);
      });
    }
    orbit?.classList.add('is-ready');
  };

  const updateFromScroll = () => {
    if (mobileArchive.matches) return;
    if (!scrollSection || !orbit || cards.length === 0 || isProgrammaticYearJump) return;
    const sectionTop = scrollSection.getBoundingClientRect().top + window.scrollY;
    const lastIndex = cards.length - 1;
    const holdDistance = window.innerHeight * 0.3;
    const yearDistance = window.innerHeight * 0.6;
    const sectionScroll = window.scrollY - sectionTop;
    const selectedIndex = Math.min(lastIndex, Math.max(0, Math.round((sectionScroll - holdDistance) / yearDistance)));
    setSelectedIndex(selectedIndex);
  };

  const setSelectedIndex = (selectedIndex: number, jumpDirection?: number) => {
    if (!orbit || !cards.length || selectedIndex === currentIndex) return;
    const previousIndex = currentIndex;
    if (!reducedMotion && previousIndex >= 0) {
      orbit.classList.add('is-transitioning');
      if (transitionTimer !== undefined) window.clearTimeout(transitionTimer);
      transitionTimer = window.setTimeout(() => orbit.classList.remove('is-transitioning'), 520);
    }
    const stageHeight = stage?.clientHeight ?? window.innerHeight;
    const stageWidth = stage?.clientWidth ?? window.innerWidth;
    const distance = mobileArchive.matches ? stageWidth : stageHeight;
    const axis = mobileArchive.matches ? 'x' : 'y';
    if (jumpDirection && previousIndex >= 0) {
      orbit.classList.add('is-positioning');
      cards.forEach((card, index) => {
        const start = index === selectedIndex
          ? jumpDirection * distance
          : index === previousIndex
            ? 0
            : (index - previousIndex) * distance;
        card.style.setProperty(`--card-${axis}`, `${start}px`);
        card.style.setProperty(`--card-${axis === 'x' ? 'y' : 'x'}`, '0px');
      });
      cards[selectedIndex]?.getBoundingClientRect();
      orbit.classList.remove('is-positioning');
    }
    currentIndex = selectedIndex;
    cards.forEach((card, index) => {
      const end = jumpDirection && index === previousIndex
        ? -jumpDirection * distance
        : (index - currentIndex) * distance;
      card.style.setProperty(`--card-${axis}`, `${end}px`);
      card.style.setProperty(`--card-${axis === 'x' ? 'y' : 'x'}`, '0px');
      card.style.setProperty('--card-transition-opacity', index === previousIndex ? '1' : '0');
    });
    yearButtons.forEach((button, index) => {
      button.setAttribute('aria-pressed', String(index === currentIndex));
    });
    cards.forEach((card, index) => {
      const selected = index === currentIndex;
      card.classList.toggle('is-active', selected);
      card.setAttribute('aria-hidden', String(!selected));
      card.tabIndex = selected ? 0 : -1;
    });
    stopImageCycle();
    const selectedCard = cards[currentIndex];
    if (selectedCard) startImageCycle(selectedCard);
  };

  const scheduleUpdate = () => {
    if (scrollFrame) return;
    scrollFrame = window.requestAnimationFrame(() => {
      scrollFrame = 0;
      updateFromScroll();
    });
  };

  const finishYearJump = () => {
    if (!isProgrammaticYearJump) return;
    isProgrammaticYearJump = false;
    if (yearJumpSettleTimer !== undefined) window.clearTimeout(yearJumpSettleTimer);
    if (yearJumpFallbackTimer !== undefined) window.clearTimeout(yearJumpFallbackTimer);
    scheduleUpdate();
  };

  const handleScroll = () => {
    if (!isProgrammaticYearJump) {
      scheduleUpdate();
      return;
    }
    if (yearJumpSettleTimer !== undefined) window.clearTimeout(yearJumpSettleTimer);
    yearJumpSettleTimer = window.setTimeout(finishYearJump, 180);
  };

  const setYear = (targetIndex: number) => {
    if (!scrollSection || cards.length < 2) return;
    const direction = targetIndex > currentIndex ? 1 : -1;
    if (mobileArchive.matches) {
      setSelectedIndex(targetIndex, direction);
      return;
    }
    const sectionTop = scrollSection.getBoundingClientRect().top + window.scrollY;
    const holdDistance = window.innerHeight * 0.3;
    const yearDistance = window.innerHeight * 0.6;
    const targetScroll = sectionTop + holdDistance + yearDistance * targetIndex;
    isProgrammaticYearJump = true;
    if (yearJumpSettleTimer !== undefined) window.clearTimeout(yearJumpSettleTimer);
    if (yearJumpFallbackTimer !== undefined) window.clearTimeout(yearJumpFallbackTimer);
    yearJumpSettleTimer = window.setTimeout(finishYearJump, 180);
    yearJumpFallbackTimer = window.setTimeout(finishYearJump, 2500);
    window.scrollTo({ top: targetScroll, behavior: reducedMotion ? 'instant' : 'smooth' });
    setSelectedIndex(targetIndex, direction);
  };

  stage?.addEventListener('pointerdown', (event) => {
    const card = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-archive-card].is-active');
    if (!mobileArchive.matches || !card || event.pointerType === 'mouse') return;
    pointerStart = { x: event.clientX, y: event.clientY, card, mode: 'pending' };
  }, { passive: true });
  stage?.addEventListener('pointermove', (event) => {
    if (!pointerStart || !mobileArchive.matches || !stage) return;
    const dx = event.clientX - pointerStart.x;
    const dy = event.clientY - pointerStart.y;
    if (pointerStart.mode === 'pending') {
      if (Math.abs(dx) < 12 && Math.abs(dy) < 12) return;
      if (Math.abs(dx) <= Math.abs(dy) * 1.15) { pointerStart = undefined; return; }
      pointerStart.mode = 'horizontal';
      orbit?.classList.add('is-dragging');
    }
    const width = stage.clientWidth;
    const atBound = (currentIndex === 0 && dx > 0) || (currentIndex === cards.length - 1 && dx < 0);
    const offset = atBound ? dx * .28 : dx;
    cards.forEach((card, index) => {
      card.style.setProperty('--card-x', `${(index - currentIndex) * width + offset}px`);
    });
  }, { passive: true });
  stage?.addEventListener('pointerup', (event) => {
    if (!pointerStart || !mobileArchive.matches) { pointerStart = undefined; return; }
    const { x, mode } = pointerStart;
    const dx = event.clientX - x;
    pointerStart = undefined;
    if (mode !== 'horizontal' || !stage) return;
    suppressCardClickUntil = Date.now() + 500;
    orbit?.classList.remove('is-dragging');
    const next = currentIndex + (dx < 0 ? 1 : -1);
    if (Math.abs(dx) >= stage.clientWidth / 3 && next >= 0 && next < cards.length) {
      setSelectedIndex(next);
    } else {
      calculateOrbit();
    }
  }, { passive: true });
  const cancelDrag = () => { pointerStart = undefined; orbit?.classList.remove('is-dragging'); calculateOrbit(); };
  stage?.addEventListener('pointercancel', cancelDrag, { passive: true });
  stage?.addEventListener('click', (event) => {
    if (Date.now() < suppressCardClickUntil && (event.target as HTMLElement).closest('[data-archive-card]')) {
      event.preventDefault();
      event.stopPropagation();
      suppressCardClickUntil = 0;
    }
  }, true);

  calculateOrbit();
  updateFromScroll();
  window.addEventListener('scroll', handleScroll, { passive: true });
  window.addEventListener('scrollend', finishYearJump, { passive: true });
  window.addEventListener('resize', () => {
    calculateOrbit();
    scheduleUpdate();
  }, { passive: true });
  mobileArchive.addEventListener('change', () => {
    calculateOrbit();
    scheduleUpdate();
  });

  yearButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const targetIndex = Number(button.dataset.yearIndex);
      if (targetIndex !== currentIndex) setYear(targetIndex);
    });
  });
</script>
