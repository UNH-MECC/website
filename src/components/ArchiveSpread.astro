---
const { project } = Astro.props;
const { year, projectTitle, projectDescription, coverImage } = project.data;
---
<div class="archive-spread" data-year-content={year}>
  <div class="archive-spread-image">
    {coverImage ? <img src={coverImage} alt={`${projectTitle || `UNH MECC ${year}`} project`} loading="lazy" decoding="async" /> : null}
  </div>
  <div class="archive-spread-copy">
    <p class="archive-spread-year">{year} PROJECT</p>
    <h2>{projectTitle || `Project ${year}`}</h2>
    <p class="archive-spread-description">{projectDescription || 'Project details coming soon.'}</p>
    <a class="archive-spread-link" href={`/archive/${year}/`}>Project and team details</a>
  </div>
</div>
